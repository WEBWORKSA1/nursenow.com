{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "User profile information for nurses and recruiters.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["nurse", "recruiter", "admin"] },
        "bio": { "type": "string" },
        "specialty": { "type": "string" },
        "experienceYears": { "type": "integer" },
        "location": { "type": "string" },
        "idealRate": { "type": "number", "description": "Preferred hourly rate for gig shifts" },
        "preferredLocations": { "type": "array", "items": { "type": "string" }, "description": "Preferred cities or regions for shifts" },
        "resumeUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "job": {
      "title": "Job Listing",
      "description": "A nursing job listing posted by a recruiter.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "hospital": { "type": "string" },
        "location": { "type": "string" },
        "type": { "type": "string", "enum": ["full-time", "part-time", "contract", "remote"] },
        "salaryRange": { "type": "string" },
        "specialty": { "type": "string" },
        "experienceLevel": { "type": "string" },
        "shiftType": { "type": "string" },
        "qualifications": { "type": "string" },
        "responsibilities": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "array", "items": { "type": "string" } },
        "postedBy": { "type": "string", "description": "Recruiter UID" },
        "isFeatured": { "type": "boolean" },
        "postedDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "hospital", "location", "type", "postedBy", "postedDate"]
    },
    "course": {
      "title": "Course",
      "description": "Educational course for nursing skills and certifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "instructor": { "type": "string" },
        "price": { "type": "number" },
        "thumbnail": { "type": "string" },
        "videoUrl": { "type": "string" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "enrollmentCount": { "type": "integer" }
      },
      "required": ["title", "description", "price"]
    },
    "application": {
      "title": "Job Application",
      "description": "A job application submitted by a nurse.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "nurseId": { "type": "string" },
        "recruiterId": { "type": "string", "description": "UID of the recruiter who posted the job" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "interviewing", "hired", "rejected"] },
        "resumeUrl": { "type": "string" },
        "coverLetter": { "type": "string" },
        "isQuickApply": { "type": "boolean", "description": "Whether this was a Quick Apply using Passport data" },
        "passportVerified": { "type": "boolean", "description": "Whether the nurse's passport was fully verified at time of application" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["jobId", "nurseId", "recruiterId", "status"]
    },
    "passport": {
      "title": "Nurse Passport",
      "description": "Verified credentials for nurses.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Nurse UID" },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state": { "type": "string" },
              "licenseNumber": { "type": "string" },
              "expiryDate": { "type": "string", "format": "date" },
              "status": { "type": "string", "enum": ["pending", "verified", "expired"] }
            }
          }
        },
        "certifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "issueDate": { "type": "string", "format": "date" },
              "expiryDate": { "type": "string", "format": "date" },
              "status": { "type": "string", "enum": ["pending", "verified", "expired"] }
            }
          }
        },
        "immunizations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "date": { "type": "string", "format": "date" },
              "status": { "type": "string", "enum": ["pending", "verified"] }
            }
          }
        },
        "isFullyVerified": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid"]
    },
    "unitReview": {
      "title": "Unit Review",
      "description": "Anonymous review of a hospital unit or ward.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospitalName": { "type": "string" },
        "unitName": { "type": "string" },
        "rating": { "type": "number" },
        "content": { "type": "string" },
        "pros": { "type": "string" },
        "cons": { "type": "string" },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hospitalName", "unitName", "rating", "content", "authorUid"]
    },
    "burnoutCheckin": {
      "title": "Burnout Check-in",
      "description": "A self-assessment of burnout levels for a nurse.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "score": { "type": "number" },
        "mood": { "type": "string" },
        "factors": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "score", "mood"]
    },
    "gigShift": {
      "title": "Gig Shift",
      "description": "A single nursing shift available for bidding or claiming.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "hospital": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "baseRate": { "type": "number" },
        "type": { "type": "string", "enum": ["Urgent", "Premium", "Standard"] },
        "status": { "type": "string", "enum": ["open", "filled", "cancelled"] },
        "postedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "hospital", "location", "date", "baseRate", "type", "status"]
    },
    "bid": {
      "title": "Shift Bid",
      "description": "A nurse's bid for a specific gig shift.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shiftId": { "type": "string" },
        "nurseId": { "type": "string" },
        "nurseName": { "type": "string" },
        "proposedRate": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shiftId", "nurseId", "proposedRate", "status"]
    },
    "employerBranding": {
      "title": "Employer Branding",
      "description": "Branding page for a hospital or healthcare facility.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospitalName": { "type": "string" },
        "tagline": { "type": "string" },
        "about": { "type": "string" },
        "culture": { "type": "string" },
        "technology": { "type": "string" },
        "benefits": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" }, "description": "URLs to images of the facility, break rooms, etc." },
        "videoUrl": { "type": "string" },
        "location": { "type": "string" },
        "website": { "type": "string" },
        "socialLinks": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string" },
            "twitter": { "type": "string" },
            "instagram": { "type": "string" }
          }
        },
        "recruiterId": { "type": "string", "description": "UID of the recruiter who manages this page" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hospitalName", "about", "recruiterId"]
    },
    "contactMessage": {
      "title": "Contact Message",
      "description": "A message sent from a potential candidate to a hospital recruiter.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hospitalId": { "type": "string", "description": "ID of the employerBranding document" },
        "recruiterId": { "type": "string", "description": "UID of the recruiter" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hospitalId", "recruiterId", "name", "email", "message"]
    },
    "jobAlert": {
      "title": "Job Alert Subscription",
      "description": "A subscription for AI-powered job alerts based on specific criteria.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "UID of the nurse" },
        "email": { "type": "string", "format": "email" },
        "specialty": { "type": "string" },
        "location": { "type": "string" },
        "experienceYears": { "type": "integer" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "specialty", "location", "isActive"]
    },
    "gigNotification": {
      "title": "Gig AI Notification",
      "description": "A notification generated by the AI agent for a matching gig shift.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string", "description": "UID of the nurse" },
        "shiftId": { "type": "string" },
        "message": { "type": "string" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "shiftId", "message", "isRead"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profiles"
    },
    "/jobs/{jobId}": {
      "schema": "job",
      "description": "Job listings"
    },
    "/courses/{courseId}": {
      "schema": "course",
      "description": "Educational courses"
    },
    "/applications/{applicationId}": {
      "schema": "application",
      "description": "Job applications"
    },
    "/passports/{userId}": {
      "schema": "passport",
      "description": "Nurse passports"
    },
    "/unitReviews/{reviewId}": {
      "schema": "unitReview",
      "description": "Anonymous unit reviews"
    },
    "/burnoutCheckins/{checkinId}": {
      "schema": "burnoutCheckin",
      "description": "Burnout self-assessments"
    },
    "/gigShifts/{shiftId}": {
      "schema": "gigShift",
      "description": "Gig shifts available for bidding"
    },
    "/bids/{bidId}": {
      "schema": "bid",
      "description": "Bids placed on gig shifts"
    },
    "/employerBranding/{brandingId}": {
      "schema": "employerBranding",
      "description": "Hospital branding pages"
    },
    "/contactMessages/{messageId}": {
      "schema": "contactMessage",
      "description": "Messages sent to recruiters via branding pages"
    },
    "/jobAlerts/{alertId}": {
      "schema": "jobAlert",
      "description": "Job alert subscriptions"
    },
    "/gigNotifications/{notificationId}": {
      "schema": "gigNotification",
      "description": "AI-generated gig shift notifications"
    }
  }
}
