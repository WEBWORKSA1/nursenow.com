{
  "name": "nursenow.com",
  "version": "2.0.0",
  "private": true,
  "description": "NurseNow — self-updating static site: nursing jobs, licensing, NCLEX prep and career tools.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "update": "node scripts/update.mjs",
